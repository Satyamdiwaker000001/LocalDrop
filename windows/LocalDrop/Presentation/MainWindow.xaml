<Window x:Class="LocalDrop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalDrop" Height="560" Width="680"
        WindowStartupLocation="CenterScreen">
    <!-- M07 UI closure: send workflow bound to SendController (the window's
         DataContext, set in App.OnStartup). Code-behind contains only view
         mechanics that delegate to the controller; no sockets, file I/O,
         crypto, or orchestration here. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="LocalDrop" />
            <TextBlock Margin="0,4,0,0" Text="Cable-free local Wi-Fi file transfer. No Internet needed." TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,4" FontWeight="Bold" Text="Nearby devices" />
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="Devices running LocalDrop on this Wi-Fi network appear automatically. Select a device — never type an address." />
            <ListBox x:Name="PeerList" Margin="0,8,0,0" Height="120"
                     ItemsSource="{Binding Peers}"
                     SelectedValuePath="DeviceId"
                     SelectedValue="{Binding SelectedPeerId, Mode=TwoWay}"
                     AutomationProperties.Name="Nearby devices">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text=" · " />
                            <TextBlock Text="{Binding DeviceType}" />
                            <TextBlock Text=" · " />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Refresh" Width="100" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="Refresh_Click" AutomationProperties.Name="Refresh nearby devices" />

            <TextBlock Margin="0,16,0,4" FontWeight="Bold" Text="File" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Choose file…" Width="110" Click="PickFile_Click"
                        AutomationProperties.Name="Choose file to send" />
                <Button Content="Clear" Width="70" Margin="8,0,0,0" Click="ClearFile_Click"
                        AutomationProperties.Name="Clear selected file" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                <Run Text="{Binding FileName, FallbackValue=No file chosen.}" />
                <Run Text="  " />
                <Run Text="{Binding FileSizeText}" />
            </TextBlock>

            <TextBlock Margin="0,16,0,4" FontWeight="Bold" Text="Receiver code" />
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="Ask the receiver to open LocalDrop and read out the 6-digit code, then type it here. The code is single-use and expires." />
            <TextBox Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" MaxLength="9"
                     Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Receiver code" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Send" Width="110" FontWeight="SemiBold" Click="Send_Click"
                        IsEnabled="{Binding CanSend}" AutomationProperties.Name="Send file" />
                <Button Content="Cancel" Width="110" Margin="8,0,0,0" Click="Cancel_Click"
                        IsEnabled="{Binding IsBusy}" AutomationProperties.Name="Cancel transfer" />
            </StackPanel>

            <TextBlock Margin="0,16,0,4" FontWeight="Bold" Text="Transfer" />
            <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         AutomationProperties.Name="Transfer progress" />
            <TextBlock Margin="0,6,0,0" Text="{Binding ProgressText}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding SpeedText}" />
                <Run Text="   " />
                <Run Text="{Binding EtaText}" />
            </TextBlock>
            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap"
                       AutomationProperties.Name="Transfer status" />
            <TextBlock Margin="0,6,0,0" Text="{Binding ResultText}" TextWrapping="Wrap"
                       AutomationProperties.Name="Transfer result" />
        </StackPanel>
    </ScrollViewer>
</Window>
