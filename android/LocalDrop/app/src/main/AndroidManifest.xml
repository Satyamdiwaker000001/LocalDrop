<?xml version="1.0" encoding="utf-8"?>
<!-- M01 Foundation: manifest shell. No transfer service behavior yet (M13). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M03: INTERNET is required for LAN UDP sockets (Android treats all
         socket use, including localhost/LAN UDP broadcast, as INTERNET).
         Normal install-time permission, no runtime prompt. No location
         (no Wi-Fi scan), no multicast lock (broadcast, not multicast).
         Foreground-service permissions below arrived with M13. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M13 service-owned graph: foreground-service permissions for the
         dataSync transfer service (targetSdk 36). FOREGROUND_SERVICE is the
         base grant; FOREGROUND_SERVICE_DATA_SYNC authorizes the declared
         dataSync type. POST_NOTIFICATIONS (API 33+) gates notification
         display at runtime (requested by the UI, not the service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="LocalDrop"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize">
            <!-- configChanges: rotation/resize must NOT destroy the Activity.
                 The transfer stacks are service-owned (TransferService);
                 the Activity only binds to observe/submit. Handling the
                 change avoids a redundant rebind; even without it,
                 recreation re-binds to the same graph and cancels nothing.
                 Compose recomposes the same state; process-death recovery
                 stays out of scope. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- M13: service-owned transfer graph. dataSync is the foreground
             type whose documented purpose is data transfer. exported=false:
             only this app starts/binds. Platform limits (documented in the
             service + m13 decisions doc, NOT claimed unlimited): the service
             must call startForeground within the system timeout; background
             starts are restricted; Doze/App Standby defer network; the user
             or system may stop the service at any time. -->
        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".widget.TransferWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/transfer_widget_info" />
        </receiver>
    </application>
</manifest>
