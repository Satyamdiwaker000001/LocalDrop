<?xml version="1.0" encoding="utf-8"?>
<!-- M01 Foundation: manifest shell. No transfer service behavior yet (M13). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M03: INTERNET is required for LAN UDP sockets (Android treats all
         socket use, including localhost/LAN UDP broadcast, as INTERNET).
         Normal install-time permission, no runtime prompt. This is the ONLY
         M03 permission: no location (no Wi-Fi scan), no multicast lock
         (broadcast, not multicast), no background-service permission (M13). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="LocalDrop"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize">
            <!-- configChanges (M07 closure): rotation/resize must NOT destroy
                 the Activity. The transfer stacks (coordinators, controllers,
                 worker threads) are owned per-Activity; recreation would
                 cancel an active transfer via close(). Handling the change
                 keeps the real transfer alive across rotation with no second
                 source of truth and no new dependency. Compose recomposes the
                 same state; process-death recovery stays out of scope (M10+).
                 No foreground service/notification/widget change (M13). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
